        "profile_id": "NEW_AGE_V2",
        "family": "New Age",
        "status": "CONTROLLED_BROAD_PROFILE",
        "scope_note": "Broad New Age baseline; rhythmic/progressive/neo-classical subprofiles may override.",
        "tempo_bpm_range": [
          55,
          105
        ],
        "meter_options": [
          "4/4",
          "3/4",
          "6/8"
        ],
        "form_tendencies": [
          "through_composed",
          "aba"
        ],
        "groove_behavior": "low-to-moderate rhythmic aggression; pulse may be flowing, sparse, arpeggiated or absent",
        "phrase_behavior": "longer melodic arcs, breath/release space, gradual entrances and exits",
        "harmony_behavior": "spacious tonal/modal harmony; add9/maj7/sus/open voicings common as options, not requirements",
        "bass_behavior": "structural support with long tones, gentle motion or pedal behavior; avoid rigid repeated two-hit templates",
        "percussion_behavior_if_applicable": "optional light percussion; when present favor supportive texture over dominant backbeat unless subtype says otherwise",
        "instrument_role_behavior": "piano/electric piano/synth, flute, guitar, harp, strings, choir/textures as target resources; role separation foreground vs depth",
        "ensemble_player_behavior": "continuous expressive shaping and low masking between melody and pads/textures",
        "arrangement_transformation": "slow evolution of texture, register, orchestration and space; silence is valid material",
        "dynamic_behavior": "long crescendos/diminuendos and section-scale breathing",
        "articulation_behavior": "legato and sustained articulation favored, with soft attacks where the selected instrument supports them",
        "timing_humanization_behavior": "phrase-level microtiming and tempo breathing; repetition must evolve",
        "continuous_performance_control": "continuous expression, pedal, attack/release and ambience controls when target supports them",
        "sound_effects_intent": "reverb/depth intentional; avoid washing out foreground definition",
        "mix_prominence_intent": "clear foreground/background depth with broad spatial field",
        "production_mastering_intent": "smooth, open, low-harshness master; transient restraint unless subtype requires more activity",
        "manufacturer_adapter_requirements": "prefer expressive target voices; preserve continuous controller curves and long releases",
        "resolution_policy": "AUTOMATIC_BASELINE_ALLOWED",
        "provenance": [
          "existing_project_theory",
          "AllMusic New Age reference already recorded in project"
        ]
