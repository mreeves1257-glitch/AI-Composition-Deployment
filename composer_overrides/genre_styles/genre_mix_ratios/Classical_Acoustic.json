        "family": "Classical",
        "status": "CONTROLLED_PROFILE",
        "scope_note": "Project common-practice tonal chamber baseline; not all Western classical music.",
        "tempo_bpm_range": [
          55,
          150
        ],
        "meter_options": [
          "4/4",
          "3/4",
          "2/4",
          "6/8"
        ],
