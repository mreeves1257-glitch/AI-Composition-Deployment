          "aba",
          "through_composed"
        ],
        "groove_behavior": "meter hierarchy and phrase rhythm drive motion; no modern groove is imposed unless explicitly hybridized",
        "phrase_behavior": "balanced phrase structures with motivic development, cadence hierarchy and sectional contrast",
        "harmony_behavior": "common-practice tonal baseline with functional harmony and voice-leading; modal/modern classical requires another profile",
        "bass_behavior": "double bass/cello/bassoon or keyboard left hand support harmonic function rather than fixed groove",
        "percussion_behavior_if_applicable": "orchestral percussion optional and structurally motivated rather than constant",
        "instrument_role_behavior": "strings, winds, brass, keyboard and chamber combinations according to role; orchestration must respect instrument authority",
        "ensemble_player_behavior": "ensemble follows score-like dynamic/articulation relationships and shared rubato",
        "arrangement_transformation": "motivic development, register transfer, contrapuntal redistribution and formal return",
        "dynamic_behavior": "wide phrase-shaped dynamics including crescendos, diminuendos and terraced contrasts where appropriate",
        "articulation_behavior": "legato/staccato/tenuto/accent/bow/breath intent passed to instrument authority",
        "timing_humanization_behavior": "shared rubato at phrase/cadence level rather than random note displacement",
        "continuous_performance_control": "expression, breath/bow/pedal and tempo curves preserved",
        "sound_effects_intent": "naturalistic room/depth baseline; effects do not replace orchestration",
        "mix_prominence_intent": "melody/counterline/harmony/bass roles remain independently audible",
        "production_mastering_intent": "retain dynamic range; avoid overcompression and excessive brightness",
        "manufacturer_adapter_requirements": "target adapters must honor canonical orchestral identities and articulations",
        "resolution_policy": "AUTOMATIC_BASELINE_ALLOWED",
        "provenance": [
