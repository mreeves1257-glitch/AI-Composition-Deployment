        "timing_humanization_behavior": "phrase breathing and shared rubato; no stereotyped sacred timing",
        "continuous_performance_control": "continuous expression and ambience",
        "sound_effects_intent": "warm room/reverb may support spaciousness without implying ritual acoustics",
        "mix_prominence_intent": "melody/lead clear with spacious support",
        "production_mastering_intent": "warm, dynamic, non-aggressive master",
        "manufacturer_adapter_requirements": "neutral target voices only unless a culturally/religiously specific verified profile is chosen",
